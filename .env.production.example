# Django production
DJANGO_ENV=production
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=ganti-dengan-secret-key-production-yang-panjang-dan-acak
DJANGO_ALLOWED_HOSTS=dn.cs.ui.ac.id
DJANGO_CSRF_TRUSTED_ORIGINS=https://dn.cs.ui.ac.id

# SMTP production. Minta host, port, akun, dan password/aplikasi dari pengelola email.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.ac.id
EMAIL_PORT=587
EMAIL_HOST_USER=dn@cs.ui.ac.id
EMAIL_HOST_PASSWORD=isi-password-atau-app-password-smtp
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=dn@cs.ui.ac.id

# Keycloak SSO production. Nilai ini diberikan oleh Unit ITF setelah client terdaftar.
SSO_PROVIDER=keycloak
KEYCLOAK_URL=https://isi-base-url-keycloak
KEYCLOAK_REALM=isi-realm
KEYCLOAK_CLIENT_ID=isi-client-id
# Kosongkan untuk public client; isi hanya bila ITF memberikan confidential-client secret.
KEYCLOAK_CLIENT_SECRET=
# Minta ITF menambahkan claim ini agar Paket Mahasiswa Aktif dapat memvalidasi angkatan.
KEYCLOAK_NPM_CLAIM=npm
KEYCLOAK_USERNAME_CLAIM=preferred_username
# ITF harus mengirim claim role ini melalui UserInfo endpoint.
KEYCLOAK_ROLE_CLAIM=roles
KEYCLOAK_STUDENT_ROLES=mahasiswa,student
KEYCLOAK_LECTURER_ROLES=dosen,lecturer
KEYCLOAK_ALUMNI_ROLES=alumni
